---
permalink: "/bio/index.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kaan Tan</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #F5F3F8; --ink-2: #DAD6E3; --body: #B7B2C4; --muted: #8A8494;
      --line: rgba(255,255,255,0.10); --surface: #1C1826; --white: #121018; --page-bg: #0B0A10;
      --display: 'Space Grotesk', sans-serif; --body-f: 'Inter', sans-serif;
    }
    body { font-family: var(--body-f); background: var(--page-bg); min-height: 100vh; display: flex; justify-content: center; padding: 32px 16px; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    .card { width: 100%; max-width: 460px; background: var(--white); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.4); height: fit-content; }
    .banner { width: 100%; height: 130px; }
    .profile { text-align: center; padding: 0 28px 8px; margin-top: -58px; }
    .avatar { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 4px solid var(--white); background: var(--surface); margin: 0 auto 14px; }
    .name { font-family: var(--display); font-size: 1.4rem; font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
    .location { display: flex; align-items: center; justify-content: center; gap: 4px; font-size: 0.85rem; color: var(--muted); margin-top: 4px; }
    .location svg { width: 14px; height: 14px; }
    .bio { font-size: 0.92rem; color: var(--body); line-height: 1.55; margin-top: 14px; white-space: pre-line; }

    .contact-row { display: flex; justify-content: center; gap: 10px; margin-top: 20px; }
    .contact-btn { display: inline-flex; align-items: center; gap: 7px; background: var(--surface); border: 1px solid var(--line); color: var(--ink-2); padding: 10px 18px; border-radius: 10px; font-size: 0.85rem; font-weight: 600; transition: background 0.2s, border-color 0.2s; }
    .contact-btn:hover { background: var(--white); border-color: var(--ink-2); }
    .contact-btn svg { width: 15px; height: 15px; }

    .follow-row { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 18px; flex-wrap: wrap; }
    .follow-pill { display: inline-flex; align-items: center; gap: 8px; padding: 5px 14px 5px 5px; border-radius: 100px; color: #FFFFFF; font-size: 0.8rem; font-weight: 700; transition: transform 0.15s, opacity 0.15s; white-space: nowrap; }
    .follow-pill:hover { transform: translateY(-1px); opacity: 0.92; }
    .fp-icon { width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,0.22); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .fp-icon svg { width: 14px; height: 14px; }
    .fp-count { font-weight: 500; opacity: 0.85; }
    .follow-pill.tiktok { background: #000000; }
    .follow-pill.instagram { background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); }
    .follow-pill.youtube { background: #FF0000; }
    .follow-pill.linkedin { background: #0A66C2; }
    .follow-pill.github { background: #171515; }
    .follow-pill.behance { background: #1769FF; }

    .links { padding: 26px 20px 28px; display: flex; flex-direction: column; gap: 12px; }
    .link-card { display: flex; align-items: center; gap: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; transition: border-color 0.2s, background 0.2s, transform 0.15s; }
    .link-card:hover { background: var(--white); transform: translateY(-1px); }
    .link-icon { flex-shrink: 0; width: 42px; height: 42px; border-radius: 11px; border: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .link-icon svg { width: 20px; height: 20px; }
    .link-icon img { width: 100%; height: 100%; object-fit: contain; padding: 6px; }
    .link-text { flex: 1; min-width: 0; }
    .link-title { font-size: 0.94rem; font-weight: 600; color: var(--ink); }
    .link-sub { font-size: 0.78rem; color: var(--muted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .link-perk { display: inline-block; margin-top: 5px; font-size: 0.7rem; font-weight: 700; color: #DED2FE; background: rgba(139,92,246,0.16); border: 1px solid rgba(139,92,246,0.3); padding: 2px 9px; border-radius: 100px; }
    .link-arrow { flex-shrink: 0; width: 16px; height: 16px; color: var(--muted); }

    .skeleton { opacity: 0.5; }
  </style>
</head>
<body>
  <div class="card skeleton" id="card">
    <div class="banner" id="banner"></div>
    <div class="profile">
      <img id="avatar" class="avatar" alt="">
      <div class="name" id="name"></div>
      <div class="location" id="locationRow" hidden><i data-lucide="map-pin"></i><span id="locationText"></span></div>
      <div class="bio" id="bioText" hidden></div>

      <div class="contact-row" id="contactRow" hidden></div>
      <div class="follow-row" id="followRow"></div>
    </div>

    <div class="links" id="linksList"></div>
  </div>

  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>
    function clickUrl(type, id) {
      return '/.netlify/functions/bio-click?type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(id);
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    var SOCIAL_ICONS = {
      youtube: '<svg viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>',
      tiktok: '<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="18" r="3" fill="white" stroke="none"/><path d="M10 18V4l7-1.5V9"/><circle cx="17" cy="10.5" r="3"/></svg>',
      instagram: '<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="6"/><circle cx="12" cy="12" r="5"/><circle cx="18" cy="6" r="1.1" fill="white" stroke="none"/></svg>',
      linkedin: '<i data-lucide="briefcase"></i>',
      github: '<i data-lucide="terminal"></i>',
      behance: '<i data-lucide="palette"></i>',
    };

    var LINK_ICONS = {
      mic: '<i data-lucide="mic"></i>',
      search: '<i data-lucide="search"></i>',
      star: '<i data-lucide="star"></i>',
      'shopping-bag': '<i data-lucide="shopping-bag"></i>',
      globe: '<i data-lucide="globe"></i>',
      'message-circle': '<i data-lucide="message-circle"></i>',
      activity: '<i data-lucide="activity"></i>',
      terminal: '<i data-lucide="terminal"></i>',
      'file-text': '<i data-lucide="file-text"></i>',
    };

    function render(bio) {
      document.title = bio.displayName || 'Kaan Tan';
      document.getElementById('card').classList.remove('skeleton');
      document.getElementById('banner').style.background = bio.bannerColor || '#4F46E5';
      document.getElementById('avatar').src = bio.avatar || '';
      document.getElementById('avatar').alt = bio.displayName || '';
      document.getElementById('name').textContent = bio.displayName || '';

      if (bio.location) {
        document.getElementById('locationText').textContent = bio.location;
        document.getElementById('locationRow').hidden = false;
      }
      if (bio.bio) {
        document.getElementById('bioText').textContent = bio.bio;
        document.getElementById('bioText').hidden = false;
      }

      var contactHtml = '';
      if (bio.showEmail && bio.email) {
        contactHtml += '<a href="mailto:' + escapeHtml(bio.email) + '" class="contact-btn"><i data-lucide="mail"></i>E-posta</a>';
      }
      if (bio.showPhone && bio.phone) {
        contactHtml += '<a href="tel:' + escapeHtml(bio.phone) + '" class="contact-btn"><i data-lucide="phone"></i>Ara</a>';
      }
      if (contactHtml) {
        document.getElementById('contactRow').innerHTML = contactHtml;
        document.getElementById('contactRow').hidden = false;
      }

      var social = bio.socialLinks || [];
      document.getElementById('followRow').innerHTML = social.map(function (s) {
        var icon = SOCIAL_ICONS[s.platform] || '<i data-lucide="link"></i>';
        var label = s.platform === 'youtube' ? 'Abone Ol' : 'Takip Et';
        var countHtml = '';
        if (s.live) {
          countHtml = '<span class="fp-count" data-live="' + s.platform + '"></span>';
        } else if (s.followerCount) {
          countHtml = '<span class="fp-count">' + escapeHtml(s.followerCount) + '</span>';
        }
        return '<a href="' + clickUrl('social', s.platform) + '" class="follow-pill ' + s.platform + '">' +
          '<div class="fp-icon">' + icon + '</div>' + label + countHtml + '</a>';
      }).join('');

      var links = bio.links || [];
      document.getElementById('linksList').innerHTML = links.map(function (link) {
        var color = link.color || bio.bannerColor || '#4F46E5';
        var iconColor = link.iconColor || '#0A0A0A';
        var iconHtml;
        if (link.icon === 'kt-logo') {
          iconHtml = '<svg viewBox="0 0 32 32" fill="none"><path d="M11 7v18M11 16l9-9M11 16l9 9" stroke="' + iconColor + '" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        } else if (link.icon === 'image' && link.iconImage) {
          iconHtml = '<img src="' + escapeHtml(link.iconImage) + '" alt="' + escapeHtml(link.title) + '">';
        } else {
          iconHtml = LINK_ICONS[link.icon] || '<i data-lucide="link"></i>';
        }
        return '<a href="' + clickUrl('link', link.id) + '" class="link-card">' +
          '<div class="link-icon" style="background:' + color + ';color:' + iconColor + ';">' + iconHtml + '</div>' +
          '<div class="link-text">' +
            '<div class="link-title">' + escapeHtml(link.title) + '</div>' +
            (link.subtitle ? '<div class="link-sub">' + escapeHtml(link.subtitle) + '</div>' : '') +
            (link.perk ? '<div class="link-perk">' + escapeHtml(link.perk) + '</div>' : '') +
          '</div>' +
          '<i data-lucide="arrow-right" class="link-arrow"></i>' +
        '</a>';
      }).join('');

      lucide.createIcons();

      fetch('/.netlify/functions/social-stats')
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (typeof data.youtube === 'number') {
            var el = document.querySelector('[data-live="youtube"]');
            if (el) el.textContent = data.youtube.toLocaleString('tr-TR') + ' abone';
          }
        })
        .catch(function () { /* sessizce yut, sayı gösterilmez */ });
    }

    fetch('/.netlify/functions/bio-config')
      .then(function (r) { return r.json(); })
      .then(render)
      .catch(function () {
        document.getElementById('name').textContent = 'Yüklenemedi';
        document.getElementById('card').classList.remove('skeleton');
      });
  </script>
</body>
</html>
